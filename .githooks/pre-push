#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
base_ref="$(git -C "$root" config --worktree --get codex-warp.preflight-base || printf '%s' origin/main)"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*)
      [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
      bash "$root/scripts/run-preflight-hook.sh" --head "$local_sha" --base "$base_ref"
      ;;
  esac
done
